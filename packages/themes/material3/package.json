{
  "name": "@astryxdesign/theme-material3",
  "version": "0.6.3",
  "displayName": "Material 3 Theme",
  "private": false,
  "description": "Source-backed Material 3 foundation theme for Astryx.",
  "author": "Meta Open Source",
  "license": "MIT",
  "homepage": "https://github.com/facebook/astryx#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/facebook/astryx.git",
    "directory": "packages/themes/material3"
  },
  "bugs": {
    "url": "https://github.com/facebook/astryx/issues"
  },
  "keywords": [
    "astryx",
    "theme",
    "design-system",
    "material-3",
    "design-tokens"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/source.js",
  "types": "./dist/source.d.ts",
  "module": "./dist/source.mjs",
  "exports": {
    ".": {
      "types": "./dist/source.d.ts",
      "import": "./dist/source.mjs",
      "require": "./dist/source.js"
    },
    "./built": {
      "types": "./dist/material3.d.ts",
      "import": "./dist/material3.js",
      "require": "./dist/material3.js"
    },
    "./theme.css": {
      "types": "./theme.css.d.ts",
      "default": "./dist/theme.css"
    },
    "./MaterialSymbol": {
      "source": "./src/MaterialSymbol.tsx",
      "types": "./dist/MaterialSymbol.d.ts",
      "import": "./dist/MaterialSymbol.mjs",
      "require": "./dist/MaterialSymbol.cjs"
    },
    "./MaterialBadge": {
      "source": "./src/MaterialBadge.tsx",
      "types": "./dist/MaterialBadge.d.ts",
      "import": "./dist/MaterialBadge.mjs",
      "require": "./dist/MaterialBadge.cjs"
    },
    "./material-symbol.css": {
      "types": "./material-symbol.css.d.ts",
      "default": "./dist/material-symbol.css"
    },
    "./material-badge.css": {
      "types": "./material-badge.css.d.ts",
      "default": "./dist/material-badge.css"
    }
  },
  "files": [
    "dist",
    "src",
    "*.css.d.ts",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE-APACHE-2.0"
  ],
  "scripts": {
    "build": "node ../../../scripts/clean-dist.mjs && astryx theme build src/material3Theme.ts -o dist/theme.css --icons-specifier ./icons.mjs && tsup && node scripts/build-material-symbol.mjs && node scripts/build-material-badge.mjs && tsc --project tsconfig.build.json && node ../../../scripts/build-css.mjs --package theme-material3 && node ../../../scripts/build-css.mjs --package theme-material3-badge && node ../../../scripts/check-fully-specified.mjs"
  },
  "peerDependencies": {
    "@astryxdesign/core": "0.6.3",
    "@stylexjs/stylex": "^0.19.0",
    "react": ">=19"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.6.3",
    "@babel/core": "catalog:",
    "@babel/plugin-transform-modules-commonjs": "7.29.7",
    "@babel/preset-react": "catalog:",
    "@babel/preset-typescript": "catalog:",
    "@stylexjs/babel-plugin": "catalog:",
    "@stylexjs/stylex": "catalog:",
    "@testing-library/react": "catalog:"
  }
}
